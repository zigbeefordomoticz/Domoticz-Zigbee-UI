{
  "name": "z4d-plugin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run prettier -s && husky install",
    "ng": "ng",
    "build": "ng build --configuration production --base-href /z4d/",
    "start": "ng serve --proxy-config proxy.conf.js --host=0.0.0.0",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint": "ng lint && stylelint \"src/**/*.scss\"",
    "test": "ng test",
    "test:ci": "npm run lint -s && ng test --code-coverage --watch=false",
    "prettier": "prettier --write \"./src/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./src/**/*.{ts,js,html,scss}\"",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/localize": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ng-select/ng-select": "24.2.1",
    "@ngneat/hotkeys": "^4.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@primeuix/themes": "^3.0.1",
    "@swimlane/ngx-charts": "^25.0.3",
    "@types/file-saver": "^2.0.7",
    "angular-highcharts": "^22.0.7",
    "bootstrap": "^5.3.8",
    "browserslist": "^4.23.0",
    "core-js": "^3.50.0",
    "cytoscape": "^3.34.3",
    "file-saver": "^2.0.5",
    "highcharts": "^13.1.1",
    "ngx-color-picker": "^20.1.1",
    "ngx-filesaver": "^22.0.0",
    "ngx-json-viewer": "^3.2.1",
    "ngx-scrollbar": "^19.1.5",
    "ngx-spinner": "^22.0.1",
    "ngx-toastr": "^20.0.5",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.2",
    "rxjs": "^7.8.1",
    "subsink": "^1.0.2",
    "tslib": "^2.6.2",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.26",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/language-service": "^21.2.25",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "https-proxy-agent": "^7.0.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0",
    "stylelint": "^16.2.1",
    "stylelint-config-recommended-scss": "^14.0.0",
    "stylelint-config-standard": "^36.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged --relative"
    }
  }
}
